# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# Riot Sign On (RSO) Integration
# =============================================================================

# Enable RSO feature (true/false)
# Set to 'true' to show Riot Sign On option in profile settings
VITE_RSO_ENABLED=false

# Demo mode for RSO (true/false)
# When enabled, creates mock Riot accounts with random ranks
# Use this for development and Riot review demo
VITE_RSO_DEMO_MODE=true

# Show official rank from Riot API (true/false)
# Set to 'false' to hide rank badges even when RSO is enabled
VITE_SHOW_OFFICIAL_RANK=true
